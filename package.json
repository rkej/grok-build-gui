{
  "name": "grok-build-gui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Codex-style desktop client for the Grok Build harness.",
  "author": "Grok Build GUI contributors",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ci": "npm run typecheck && npm test",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  }
}
