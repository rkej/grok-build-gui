{
  "name": "grok-build-gui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Codex-style desktop client for the Grok Build harness.",
  "author": "Grok Build GUI contributors",
  "homepage": "https://github.com/rkej/grok-build-gui",
  "bugs": {
    "url": "https://github.com/rkej/grok-build-gui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkej/grok-build-gui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ci": "npm run typecheck && npm test && npm run build",
    "start": "electron-vite preview",
    "icon": "node scripts/write-icon.mjs",
    "package": "npm run build && npm run icon && electron-builder --publish never",
    "package:dir": "npm run build && npm run icon && electron-builder --dir --publish never",
    "package:mac": "npm run build && npm run icon && electron-builder --mac --publish never",
    "package:linux": "npm run build && npm run icon && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
